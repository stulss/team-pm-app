# Supabase > Project Settings > Database > Connection string
# 런타임: Transaction pooler (포트 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 마이그레이션 전용: Session pooler (5432) 또는 direct 연결
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 로컬 개발에서는 비워도 됨(단일 인스턴스 모드). 배포에서는 필수.
REDIS_URL=

PORT=4000
# 로컬에서 client(5173)를 프록시 없이 직접 호출할 때만 필요
CLIENT_ORIGIN=

# JWT 서명 키(32자 이상). 생성: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Vercel Cron(/api/cron/daily) 인증용(16자 이상). 없으면 cron 엔드포인트는 비활성.
CRON_SECRET=
# 마감일 "오늘/내일" 판정 시간대 (기본 Asia/Seoul)
APP_TIMEZONE=Asia/Seoul
# false 로 두면 새 가입을 막는다(첫 계정은 항상 허용)
ALLOW_REGISTRATION=true
